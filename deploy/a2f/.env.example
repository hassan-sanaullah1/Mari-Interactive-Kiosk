# Audio2Face-3D NIM — deploy-side config. Copy to deploy/a2f/.env (gitignored).
# This is SEPARATE from the repo-root .env: these settings configure the NIM
# container itself, while the root .env's APP_A2F_* configure the app's client.

# NGC key with access to the Audio2Face-3D NIM (from build.nvidia.com).
NGC_API_KEY=

# Optional: reuse a model cache volume that already exists on this host.
# A2F_CACHE_VOLUME=mari_a2f_cache
# A2F_CACHE_EXTERNAL=false
