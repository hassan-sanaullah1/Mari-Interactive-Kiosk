# MARI × speech-to-speech — environment. Copy to `.env`.
# Same APP_* names as the kiosk repo so one set of secrets serves both.

# ── LLM ─────────────────────────────────────────────────────────────
# Two providers, both OpenAI-compatible. DeepSeek (APP_LLM_*) wins when its base and
# key are both set; force either with APP_LLM_PROVIDER.
APP_LLM_PROVIDER=
APP_LLM_API_BASE=
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-chat
# Low on purpose: the reply has to restate figures and dates from the retrieved
# knowledge, and at 0.7 the model swapped them.
APP_LLM_TEMPERATURE=0.3

# ── LLM — vLLM (Qwen3.5) ────────────────────────────────────────────
# s2s reaches this via --llm_backend chat-completions (see scripts/run_*.sh)
APP_VLLM_API_BASE=http://your-vllm-host:8000/v1
APP_VLLM_API_KEY=
APP_VLLM_MODEL=qwen3.5

# ── STT — Soniox (Urdu, custom handler) ─────────────────────────────
APP_SONIOX_API_KEY=
APP_SONIOX_BASE_URL=wss://stt-rt.jp.soniox.com/transcribe-websocket
APP_SONIOX_MODEL=stt-rt-v4

# ── TTS — Uplift (Urdu, and English while APP_EN_TTS=uplift) ────────
APP_UPLIFT_API_KEY=
APP_UPLIFT_TTS_BASE_URL=https://ap-southeast-1.api.upliftai.org
APP_UPLIFT_TTS_API_PATH=/v1/synthesis/text-to-speech
APP_UPLIFT_VOICE_ID=v_8eelc901v6
# Voice for English replies; defaults to APP_UPLIFT_VOICE_ID (one persona, both languages).
APP_UPLIFT_VOICE_ID_EN=
# Voice for the male presenter (frontend/components/avatar/models.ts). Defaults to
# APP_UPLIFT_VOICE_ID, i.e. both rigs share one voice until this is set.
# Ids: https://docs.upliftai.org/orator_voices
APP_UPLIFT_VOICE_ID_MALE=prime-time-anchor
APP_UPLIFT_OUTPUT_FORMAT=MP3_22050_128
# Speaking rate for both languages. Below 1.0 because the voice clips short unstressed
# words at the default ("about us" lost its "us"). Not monotonic — 0.95 measures worse
# than 1.0 — so retune by listening/measuring, not by nudging.
APP_UPLIFT_SPEED=0.9
# Speaking rate for ENGLISH only, overriding APP_UPLIFT_SPEED. Lower because the
# receptionist persona reads English prose at a brisk customer-service clip that lands
# as rushed; Urdu keeps its own measured rate above. Lower this (try 0.82) for a more
# unhurried assistant, but re-listen at each step — the curve is not monotonic.
APP_UPLIFT_SPEED_EN=0.98

# ── TTS — local Matcha-TTS Urdu voices (off by default) ──
# "matcha" sends Urdu sentences to a local TTS server instead of Uplift. It serves one
# voice per presenter, named in each request, so either or both presenters can use it.
# All English stays on the voices above. Default: uplift.
#
#   APP_UR_TTS            the default engine for every presenter: uplift | matcha
#   APP_UR_TTS_<ID>       overrides it for one presenter (the ids in server/personas.toml)
#
# both local:        APP_UR_TTS=matcha
# both paid:         APP_UR_TTS=uplift
# female local only: APP_UR_TTS=matcha  + APP_UR_TTS_MALE=uplift
# male local only:   APP_UR_TTS=matcha  + APP_UR_TTS_FEMALE=uplift
# APP_UR_TTS=matcha
# APP_UR_TTS_FEMALE=uplift
# APP_UR_TTS_MALE=uplift
# The server's address. 127.0.0.1 when this backend runs on the host; for a backend in
# Docker use the host's bridge address (172.17.0.1), and bind the server to it.
# APP_MATCHA_TTS_URL=http://127.0.0.1:8030
# 1.0 is the model's own pace; clamped to 0.6–1.5.
# APP_MATCHA_SPEED=1.0
# 1 (default): a sentence the local server can't render is spoken by Uplift instead, in
# that presenter's own Uplift voice.
# APP_MATCHA_FALLBACK=1

# ── English STT ────────────────────────────────────────────────────
# "local" runs faster-whisper in-process (no key); "remote" posts to an
# OpenAI-compatible /audio/transcriptions endpoint.
APP_EN_STT=local
APP_ASR_MODEL_SIZE=large-v3-turbo

# Remote English speech to text, used only when APP_EN_STT=remote.
APP_REMOTE_WHISPER_URL=
APP_REMOTE_WHISPER_TOKEN=
APP_REMOTE_WHISPER_MODEL=whisper-1

# ── English TTS — three local engines + Uplift (paid) fallback ─────
# Three engines can speak English, all running on the same machine:
#
#   "remote"   a local OpenAI-compatible TTS server (OmniVoice or Kokoro)
#              reached at APP_REMOTE_TTS_API_BASE. Male + female, Pakistani accent.
#              Repo:  ~/Desktop/mari-tts-server   (docker compose up -d --build)
#              Port:  8080
#
#   "local"    Kokoro-82M in-process inside the kiosk backend. Build with
#              `make dev KOKORO=1` (or `make prod KOKORO=1`) first; the default
#              backend image does NOT include torch/Kokoro.
#              No separate server needed.
#
#   "uplift"   the paid UpliftAI API (APP_UPLIFT_* above). Fallback when you have
#              no local GPU or want a quick test without running a model.
#
#   APP_EN_TTS            the default engine for every presenter: remote | local | uplift
#   APP_EN_TTS_<ID>       overrides it for one presenter (ids from server/personas.toml)
#
# Examples:
#   both OmniVoice:          APP_EN_TTS=remote
#   both Kokoro in-process:  APP_EN_TTS=local
#   both paid:               APP_EN_TTS=uplift
#   female OmniVoice, male Kokoro:  APP_EN_TTS=remote  + APP_EN_TTS_MALE=local
#   female Kokoro, male paid:       APP_EN_TTS=local   + APP_EN_TTS_MALE=uplift
APP_EN_TTS=uplift
# APP_EN_TTS_FEMALE=remote
# APP_EN_TTS_MALE=remote

# ── English TTS — "remote" server settings (OmniVoice / Kokoro) ───
# Used only when a presenter's English engine is "remote". Point this at whichever
# OpenAI-compatible TTS server is running locally (both OmniVoice and Kokoro serve
# the same /v1/audio/speech API).
#
# OmniVoice (mari-tts-server):  http://127.0.0.1:8080
# A standalone Kokoro server:   http://127.0.0.1:<its-port>
#
# For Docker: use the host bridge address (172.17.0.1) instead of 127.0.0.1.
APP_REMOTE_TTS_API_BASE=http://127.0.0.1:8080
APP_REMOTE_TTS_API_PATH=/v1/audio/speech
APP_REMOTE_TTS_TOKEN=
APP_REMOTE_TTS_MODEL=kokoro
APP_REMOTE_TTS_RESPONSE_FORMAT=mp3

# ── Voice names ────────────────────────────────────────────────────
# Which voice the TTS engine selects per request. These apply when a presenter is
# routed to Kokoro (local or remote) or OmniVoice (remote). Uplift voices are per
# presenter and live in server/personas.toml.
#
# OmniVoice accepts: mari_female / mari_male, or Kokoro-style names (af_* -> female,
# am_* -> male). Kokoro local uses its own voice names (af_heart, am_michael, etc.).
APP_TTS_VOICE_ENGLISH=af_heart
APP_TTS_VOICE_ENGLISH_MALE=am_michael
APP_TTS_VOICE_URDU=af_heart

# ── Avatar lipsync — NVIDIA Audio2Face-3D NIM (gRPC) ────────────────
# Unset APP_A2F_URL and the kiosk runs exactly as before, minus lipsync.
# Forms: host:port | grpc://host:port | grpcs://host[:port] (TLS + API key)
APP_A2F_URL=
APP_A2F_API_KEY=
APP_A2F_TLS_CA=
# Reply sentences the NIM may work on at once. Must not exceed its own
# `stream_number` (deploy/a2f/configs/deployment_config.yaml): 1 on a 6 GB GPU.
APP_A2F_MAX_CLIPS=1

# ── The corpus read for speech fixes ────────────────────────────────
# Which proper nouns and acronyms the Urdu script fixes recognise. NOT what retrieval
# ingests — that is MARI_RAG_CORPUS_DIR below.
APP_KNOWLEDGE_FILE=

# ── Server ──────────────────────────────────────────────────────────
MARI_HOST=127.0.0.1
MARI_PORT=8010
# Answer every turn with the canned demo line, without calling the LLM.
MARI_FORCE_DEMO=0
# Which deployment this is (local, dev, staging, prod) and the deployed commit.
# Both are reported by /health/ready. On Coolify set APP_COMMIT=$SOURCE_COMMIT.
APP_ENV=local
APP_COMMIT=

# ── Retrieval (RAG) — server/rag/*, prefix MARI_RAG_ ────────────────
# Only the settings worth changing per deployment are listed. The rest have measured
# defaults; every one of them, with the measurement behind it, is in docs/retrieval.md and
# docs/retrieval-tuning-notes.md. The full list is the fields of
# server/rag/settings.py::RagSettings.
MARI_RAG_CORPUS_DIR=
MARI_RAG_METADATA_DB=
# Every value here has a documented rationale in docs/retrieval.md; the defaults are the
# ones the eval harness (eval/run_eval.py) was last run against. Change one, re-run it.

# Qdrant. Inside docker-compose the host is the service name. The API key is REQUIRED:
# Qdrant ships with no authentication and its REST API can delete collections.
MARI_RAG_QDRANT_HOST=127.0.0.1
MARI_RAG_QDRANT_PORT=6333
MARI_RAG_QDRANT_API_KEY=
MARI_RAG_QDRANT_COLLECTION=mari_knowledge
# Leave false for a plaintext internal network. qdrant-client silently flips to HTTPS
# whenever an api_key is set, which breaks that connection in a way that looks nothing
# like its cause.
MARI_RAG_QDRANT_HTTPS=false

# Models. Multilingual dense is required while the kiosk takes Urdu questions against
# an English corpus; see docs/retrieval.md before changing it to an English-only model.
MARI_RAG_DENSE_MODEL=intfloat/multilingual-e5-large
MARI_RAG_DENSE_DIM=1024
MARI_RAG_SPARSE_MODEL=Qdrant/bm25
MARI_RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
MARI_RAG_RERANK_ENABLED=true

# Chunking (tokens, via the embedding model's own tokenizer — not words).
MARI_RAG_CHUNK_TOKENS=320
MARI_RAG_CHUNK_OVERLAP_RATIO=0.15
MARI_RAG_MIN_CHUNK_TOKENS=30

# Retrieval shape.
MARI_RAG_PREFETCH_LIMIT=30
MARI_RAG_RERANK_CANDIDATES=20
MARI_RAG_TOP_K=5
MARI_RAG_SCORE_THRESHOLD=0.3

# Conditional query rewriting for elliptical follow-ups. Timeout-guarded; on timeout
# the raw transcript is used and the turn proceeds.
MARI_RAG_REWRITE_ENABLED=true
MARI_RAG_REWRITE_TIMEOUT_MS=150

# Set true once to rebuild the index from scratch, then set it back.
MARI_RAG_FORCE_REINGEST=false

# ── Recording aid — TEMPORARY ───────────────────────────────────────
# Set to 1 and every turn, on either presenter and in either language, answers with
# that presenter's fixed pitch line (server/prompts/replies.toml: [pitch.*]), whatever
# the visitor said and without calling the LLM. The kiosk stops answering questions while this is on — leave it unset/0 for
# any real deployment.
# MARI_PITCH_ONLY=1

# ═══════════════════════════════════════════════════════════════════
# NEW-PC QUICK REFERENCE — what to clone and start for each local TTS
# ═══════════════════════════════════════════════════════════════════
#
# 1. Matcha-TTS (Urdu, male + female)
#    Clone:  git clone <repo> ~/Desktop/kiosk-tts-server
#    Start:  cd ~/Desktop/kiosk-tts-server && docker compose up -d --build
#    Port:   8030
#    Kiosk:  APP_UR_TTS=matcha  APP_MATCHA_TTS_URL=http://127.0.0.1:8030
#
# 2. OmniVoice (English, male + female, Pakistani accent)
#    Clone:  git clone <repo> ~/Desktop/mari-tts-server
#    Setup:  pip install -U "huggingface_hub[cli]"
#            huggingface-cli download k2-fsa/OmniVoice --local-dir models/omnivoice
#    Start:  cd ~/Desktop/mari-tts-server && docker compose up -d --build
#    Port:   8080
#    Kiosk:  APP_EN_TTS=remote  APP_REMOTE_TTS_API_BASE=http://127.0.0.1:8080
#
# 3. Kokoro (English, in-process inside the kiosk backend)
#    No separate repo. Build the kiosk backend with Kokoro included:
#    Start:  make dev KOKORO=1   (or make prod KOKORO=1)
#    Kiosk:  APP_EN_TTS=local
#
# All-local, no paid API:
#    APP_UR_TTS=matcha
#    APP_MATCHA_TTS_URL=http://127.0.0.1:8030
#    APP_EN_TTS=remote
#    APP_REMOTE_TTS_API_BASE=http://127.0.0.1:8080
