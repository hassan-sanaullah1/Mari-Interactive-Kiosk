# MARI × speech-to-speech — environment. Copy to `.env`.
# Same APP_* names as the kiosk repo so one set of secrets serves both.

# ── LLM — vLLM (Qwen3.5, OpenAI-compatible) ─────────────────────────
# s2s reaches this via --llm_backend chat-completions (see scripts/run_*.sh)
APP_VLLM_API_BASE=http://your-vllm-host:8000/v1
APP_VLLM_API_KEY=
APP_VLLM_MODEL=qwen3.5

# ── STT — Soniox (Urdu, custom handler) ─────────────────────────────
APP_SONIOX_API_KEY=
APP_SONIOX_API_BASE=wss://stt-rt.soniox.com/transcribe-websocket
APP_SONIOX_MODEL=stt-rt-preview

# ── TTS — Uplift (Urdu, and English while APP_EN_TTS=uplift) ────────
APP_UPLIFT_API_KEY=
APP_UPLIFT_TTS_BASE_URL=https://ap-southeast-1.api.upliftai.org
APP_UPLIFT_VOICE_ID=v_8eelc901v6
# Voice for English replies; defaults to APP_UPLIFT_VOICE_ID (one persona, both languages).
APP_UPLIFT_VOICE_ID_EN=
# Voice for the male presenter (frontend/components/avatar/models.ts). Defaults to
# APP_UPLIFT_VOICE_ID, i.e. both rigs share one voice until this is set.
# Ids: https://docs.upliftai.org/orator_voices
APP_UPLIFT_VOICE_ID_MALE=prime-time-anchor
APP_UPLIFT_OUTPUT_FORMAT=MP3_22050_128
# Speaking rate for both languages. Below 1.0 because the voice clips short unstressed
# words at the default ("about us" lost its "us"). Not monotonic — 0.95 measures worse
# than 1.0 — so retune by listening/measuring, not by nudging.
APP_UPLIFT_SPEED=0.9
# Speaking rate for ENGLISH only, overriding APP_UPLIFT_SPEED. Lower because the
# receptionist persona reads English prose at a brisk customer-service clip that lands
# as rushed; Urdu keeps its own measured rate above. Lower this (try 0.82) for a more
# unhurried assistant, but re-listen at each step — the curve is not monotonic.
APP_UPLIFT_SPEED_EN=0.98

# ── English ─────────────────────────────────────────────────────────
# STT: faster-whisper (local). TTS: "uplift" (default — no Kokoro deployed),
# or "local"/"remote" for kokoro-82m.
APP_EN_TTS=uplift
APP_ASR_MODEL_SIZE=large-v3-turbo

# ── Avatar lipsync — NVIDIA Audio2Face-3D NIM (gRPC) ────────────────
# Unset APP_A2F_URL and the kiosk runs exactly as before, minus lipsync.
# Forms: host:port | grpc://host:port | grpcs://host[:port] (TLS + API key)
APP_A2F_URL=
APP_A2F_API_KEY=
APP_A2F_TLS_CA=

# ── Retrieval (RAG) — server/services/*, prefix MARI_RAG_ ───────────
# Every value here has a documented rationale in README-RAG.md; the defaults are the
# ones the eval harness (eval/run_eval.py) was last run against. Change one, re-run it.

# Qdrant. Inside docker-compose the host is the service name. The API key is REQUIRED:
# Qdrant ships with no authentication and its REST API can delete collections.
MARI_RAG_QDRANT_HOST=127.0.0.1
MARI_RAG_QDRANT_PORT=6333
MARI_RAG_QDRANT_API_KEY=
MARI_RAG_QDRANT_COLLECTION=mari_knowledge
# Leave false for a plaintext internal network. qdrant-client silently flips to HTTPS
# whenever an api_key is set, which breaks that connection in a way that looks nothing
# like its cause.
MARI_RAG_QDRANT_HTTPS=false

# Models. Multilingual dense is required while the kiosk takes Urdu questions against
# an English corpus; see README-RAG.md before changing it to an English-only model.
MARI_RAG_DENSE_MODEL=intfloat/multilingual-e5-large
MARI_RAG_DENSE_DIM=1024
MARI_RAG_SPARSE_MODEL=Qdrant/bm25
MARI_RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
MARI_RAG_RERANK_ENABLED=true

# Chunking (tokens, via the embedding model's own tokenizer — not words).
MARI_RAG_CHUNK_TOKENS=320
MARI_RAG_CHUNK_OVERLAP_RATIO=0.15
MARI_RAG_MIN_CHUNK_TOKENS=30

# Retrieval shape.
MARI_RAG_PREFETCH_LIMIT=30
MARI_RAG_RERANK_CANDIDATES=20
MARI_RAG_TOP_K=5
MARI_RAG_SCORE_THRESHOLD=0.3

# Conditional query rewriting for elliptical follow-ups. Timeout-guarded; on timeout
# the raw transcript is used and the turn proceeds.
MARI_RAG_REWRITE_ENABLED=true
MARI_RAG_REWRITE_TIMEOUT_MS=150

# Set true once to rebuild the index from scratch, then set it back.
MARI_RAG_FORCE_REINGEST=false

# ── Recording aid — TEMPORARY ───────────────────────────────────────
# Set to 1 and every turn, on either presenter and in either language, answers with
# that presenter's fixed pitch line (server/prompts/replies.toml: [pitch.*]), whatever
# the visitor said and without calling the LLM. The kiosk stops answering questions while this is on — leave it unset/0 for
# any real deployment.
# MARI_PITCH_ONLY=1
